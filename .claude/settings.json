{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.ci)",
      "Read(**/.env.preview)",
      "Read(**/.env.stage)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.keys)",
      "Read(**/.env.vault)",
      "Read(**/.envrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-reads.py\""
          }
        ]
      }
    ]
  }
}
