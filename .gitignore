# Repo-wide ignores. Apps add their own .gitignore only for tool-specific output
# (for example apps/web for Next.js); the Python and env-file rules for every app live here.
# apps/web's generated .gitignore repeats the env rule, so it carries its own !.env.example.

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Node
node_modules/
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
*.egg-info/

# Env files: commit .env.example, never real values
.env
.env.*
!.env.example

# Claude Code: per-user settings, and the git worktrees its agents work in
.claude/settings.local.json
.claude/worktrees/

# Agent skills that tools install (the `skills` CLI, Clerk's CLI) are per machine, never
# committed: they stay on the machine that installed them. The repo commits only its own
# skills, each listed here with a `!` line.
/.claude/skills/*
!/.claude/skills/test-audit/
/.agents/
/.grok/
/.hermes/
/skills/*
!/skills/myapp/
/skills-lock.json

# Clerk's local claim and keyless files
/.clerk/

# Written by scripts/build-packages.sh for release builds; never committed.
apps/cli/src/myapp/release_api_url.txt

# Release packages built locally by scripts/build-packages.sh
/dist/

# packages/e2e: Playwright's own run output (HTML report, traces, screenshots) --
# regenerated by every `pnpm e2e` run, never committed.
packages/e2e/playwright-report/
packages/e2e/test-results/
