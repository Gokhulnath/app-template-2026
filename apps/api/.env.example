# Local overrides: copy to .env (gitignored). Every variable is optional.

# Exact CORS origins, comma-separated. Default: the packaged Tauri origins.
# CORS_ORIGINS=tauri://localhost,http://tauri.localhost

# Allow any http://localhost / 127.0.0.1 port (dev servers): true or false. Default false;
# `pnpm dev:api` sets it to true. Never enable it in production.
# CORS_ALLOW_LOCALHOST=false

# The API connects as the least-privilege myapp_api role. Default: the local Supabase
# stack started by `pnpm db:start`. The cloud URL lives only in Doppler (project myapp, config prd).
# DATABASE_URL=postgresql+asyncpg://myapp_api:myapp_api@127.0.0.1:54322/postgres

# Seconds /health waits for the database before reporting it unavailable (default 5).
# DB_HEALTH_TIMEOUT=5
# The connection pool per API process: connections kept open, extra ones allowed under load,
# and seconds a request waits for a free one before it's treated as unavailable. Each process
# uses at most DB_POOL_SIZE + DB_MAX_OVERFLOW; see docs/architecture.md.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=5
