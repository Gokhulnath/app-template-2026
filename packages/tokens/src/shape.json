{
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": { "value": 4, "unit": "px" },
      "$description": "Checkboxes."
    },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": {
      "$value": { "value": 12, "unit": "px" },
      "$description": "Inputs, alerts."
    },
    "xl": { "$value": { "value": 16, "unit": "px" }, "$description": "Cards." },
    "full": {
      "$value": { "value": 9999, "unit": "px" },
      "$description": "Buttons and pills."
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#0000000d",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": {
        "color": "#0000001a",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": -2, "unit": "px" }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": { "value": 120, "unit": "ms" },
        "$description": "Hover and press feedback."
      },
      "base": {
        "$value": { "value": 200, "unit": "ms" },
        "$description": "Things appearing or moving."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  }
}
